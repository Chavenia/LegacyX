{
  "name": "legacyx",
  "version": "1.0.0",
  "description": "LegacyX: AI-powered developer governance sidecar and modernization engine for enterprise Java",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node test/test-scan.js",
    "remotion:studio": "npm --prefix frontend run remotion:studio",
    "remotion:render": "npm --prefix frontend run remotion:render",
    "remotion:still": "npm --prefix frontend run remotion:still",
    "voiceover:generate": "node scripts/generate-gemini-voiceover.mjs",
    "voiceover:generate:charon": "node scripts/generate-gemini-voiceover.mjs --voice=Charon",
    "voiceover:generate:kore": "node scripts/generate-gemini-voiceover.mjs --voice=Kore",
    "voiceover:generate:puck": "node scripts/generate-gemini-voiceover.mjs --voice=Puck"
  },
  "keywords": [
    "legacyx",
    "modernization",
    "java21",
    "spring-boot-3",
    "jakarta",
    "ibm-bob",
    "watsonx"
  ],
  "author": "LegacyX Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "glob": "^11.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.529",
    "xml2js": "^0.6.2"
  }
}
