# ==============================================================================
# LegacyX Environment Configuration
# ==============================================================================

# Server port (default: 5000)
PORT=5000

# GitHub Personal Access Token (for private enterprise repositories & PR creation)
GITHUB_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# Google Gemini 3.1 Flash TTS Voiceover Configuration
# ──────────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY
#   API key from Google AI Studio (https://aistudio.google.com/apikey).
#   Used by `npm run voiceover:generate` to synthesize studio-quality narration
#   using Gemini 3.1 Flash TTS (gemini-3.1-flash-tts-preview).
GEMINI_API_KEY=

# GEMINI_VOICE
#   Voice persona to use. Available: Charon (default, informative), Kore (firm),
#   Puck (upbeat), Fenrir (excitable), Aoede (breezy), Sadaltager (knowledgeable).
GEMINI_VOICE=Charon

# ──────────────────────────────────────────────────────────────────────────────
# Deliverable 3 — watsonx Orchestrate Slack Approval Gateway
# ──────────────────────────────────────────────────────────────────────────────
#
# SLACK_WEBHOOK_URL
#   Incoming Webhook URL created at https://api.slack.com/apps → Incoming Webhooks.
#   When set, POST /api/deliver will send the Block Kit audit card live.
#   When left blank, the gateway falls back to dry-run mode: it prints the full
#   formatted Block Kit JSON to the console instead of making any HTTP request.
#
#   Example: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXX
SLACK_WEBHOOK_URL=

# SLACK_BOT_TOKEN
#   OAuth Bot Token (xoxb-…) for advanced Slack API calls (e.g. chat.update,
#   reactions, interactive message handling via Events API).
#   Not required for basic webhook delivery — only needed if you extend
#   the gateway to use the Web API directly.
SLACK_BOT_TOKEN=

# SLACK_CHANNEL
#   Default channel to post audit cards to (override per-request via body).
#   Must be a channel the webhook/bot has access to.
#   Example: #engineering-governance
SLACK_CHANNEL=#engineering-governance

# ──────────────────────────────────────────────────────────────────────────────

# Custom sandbox directory (defaults to OS temp directory / legacyx-sandbox)
# LEGACYX_SANDBOX_DIR=/tmp/legacyx-sandbox
