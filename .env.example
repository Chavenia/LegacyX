# ==============================================================================
# LegacyX Environment Configuration
# ==============================================================================

# Server port (default: 5000)
PORT=5000

# GitHub Personal Access Token (for private enterprise repositories & PR creation)
GITHUB_TOKEN=

# Slack Webhook URL / Bot Token for watsonx Orchestrate approvals (Deliverable 3)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Custom sandbox directory (defaults to OS temp directory / legacyx-sandbox)
# LEGACYX_SANDBOX_DIR=/tmp/legacyx-sandbox
